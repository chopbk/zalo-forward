# Zalo Bot Platform (control plane)
ZALO_BOT_TOKEN=
# polling (local) | webhook (prod)
ZALO_BOT_TRANSPORT=polling
ZALO_BOT_WEBHOOK_PATH=/webhooks/zalo-bot
ZALO_BOT_WEBHOOK_SECRET=
ZALO_BOT_POLL_TIMEOUT_SEC=30

ADMIN_SETUP_PASSWORD=doi-mat-khau-nay
ADMIN_ZALO_USER_IDS=

DATABASE_PATH=./data/app.db
SESSION_DIR=./data/sessions
QR_DIR=./data/qr

ZALO_MIN_SEND_INTERVAL_MS=1500
ZALO_SEND_MAX_PER_MINUTE=20
JOB_MAX_RETRIES=3
LIST_PAGE_SIZE=20

PORT=3080
LOG_LEVEL=info

# === Gửi ảnh QR trên VPS (bắt buộc HTTPS) ===
# Cách 1 (khuyên dùng): nginx/caddy + Let's Encrypt
#   PUBLIC_BASE_URL=https://qr.domain-cua-ban.com
#   (proxy /qr/ → http://127.0.0.1:3080/qr/)
PUBLIC_BASE_URL=

# Cách 2: key miễn phí https://api.imgbb.com/ → tạo key
IMGBB_API_KEY=

# Fallback upload telegra/catbox nếu chưa có 2 cách trên
QR_TEMP_UPLOAD=true
# VPS: để false. Dev local mới bật tunnel
QR_AUTO_TUNNEL=false
QR_OPEN_LOCAL=false

NODE_ENV=production
