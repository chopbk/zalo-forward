# Zalo Bot Platform (control plane)
ZALO_BOT_TOKEN=
# polling (local) | webhook (prod)
ZALO_BOT_TRANSPORT=polling
ZALO_BOT_WEBHOOK_PATH=/webhooks/zalo-bot
ZALO_BOT_WEBHOOK_SECRET=
ZALO_BOT_POLL_TIMEOUT_SEC=30

# Cách dễ: đặt mật khẩu, chat bot gõ /iamadmin <mật_khẩu> — id được lưu DB
ADMIN_SETUP_PASSWORD=doi-mat-khau-nay

# Tuỳ chọn: seed sẵn id admin (không bắt buộc nếu đã có ADMIN_SETUP_PASSWORD)
ADMIN_ZALO_USER_IDS=

DATABASE_PATH=./data/app.db
SESSION_DIR=./data/sessions
QR_DIR=./data/qr

ZALO_MIN_SEND_INTERVAL_MS=1500
ZALO_SEND_MAX_PER_MINUTE=20
JOB_MAX_RETRIES=3
LIST_PAGE_SIZE=20

PORT=3080
LOG_LEVEL=info
# Base URL công khai để phục vụ ảnh QR (nếu bot không nhận ảnh local)
PUBLIC_BASE_URL=
NODE_ENV=development
